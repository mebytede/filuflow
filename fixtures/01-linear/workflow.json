      "parameters": {
        "jsCode": "const first = $input.first().json;\nconst out = [];\nfor (let i = 0; i < first.count + 2; i++) {\n  out.push({ json: { i, name: first.name + i, even: i % 2 === 0, score: i * 1.5, city: first.info.city } });\n}\nreturn out;"
      },
      "id": "a3", "name": "Erzeugen", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [440, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2 },
          "conditions": [
            { "id": "c1", "leftValue": "={{ $json.score }}", "rightValue": 2, "operator": { "type": "number", "operation": "gt" } },
            { "id": "c2", "leftValue": "={{ $json.name }}", "rightValue": "Max0", "operator": { "type": "string", "operation": "equals", "name": "filter.operator.equals" } }
          ],
          "combinator": "or"
        },
        "options": {}
      },
