{
  "name": "filuflow",
  "version": "0.1.0",
  "description": "Self-hosted workflow engine with a browser editor, webhooks, schedules, AI nodes and multi-tenant operation; runs workflows in the common workflow JSON format without changes",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "author": "the filuflow authors (maintained by mebytede)",
  "homepage": "https://github.com/mebytede/filuflow#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mebytede/filuflow.git"
  },
  "bugs": {
    "url": "https://github.com/mebytede/filuflow/issues"
  },
  "keywords": [
    "workflow",
    "workflow-engine",
    "automation",
    "workflow-automation",
    "webhooks",
    "low-code",
    "self-hosted",
    "ai",
    "multi-tenant"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "filuflow": "bin/filuflow.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && npm run build:ui",
    "test": "vitest run --exclude 'test/compat/**'",
    "test:compat": "vitest run test/compat",
    "lint": "eslint . && tsc --noEmit && tsc -p tsconfig.ui.json --noEmit",
    "filuflow": "tsx src/cli/main.ts",
    "build:ui": "tsc -p tsconfig.ui.json && node scripts/copy-ui-assets.mjs"
  },
  "dependencies": {
    "acorn": "^8.19.0",
    "alasql": "4.4.0",
    "astring": "^1.9.0",
    "better-sqlite3": "^13.0.3",
    "cheerio": "1.0.0-rc.6",
    "croner": "^10.0.1",
    "fastify": "^5.12.7",
    "html-to-text": "9.0.5",
    "jmespath": "0.16.0",
    "jsonrepair": "3.13.1",
    "lodash": "4.18.1",
    "luxon": "3.4.4",
    "math-expression-evaluator": "2.0.7",
    "pino": "^10.4.0",
    "pyodide": "0.28.0",
    "qs": "6.17.1",
    "title-case": "3.0.3",
    "transliteration": "2.3.5",
    "undici": "^8.12.3",
    "xml2js": "0.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/html-to-text": "^9.0.4",
    "@types/jmespath": "^0.15.2",
    "@types/lodash": "^4.17.26",
    "@types/luxon": "^3.7.6",
    "@types/node": "^22.20.5",
    "@types/qs": "^6.15.1",
    "@types/xml2js": "^0.4.14",
    "eslint": "^10.13.0",
    "playwright-core": "1.56.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
